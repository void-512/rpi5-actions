# Scheduling and task accounting

# CONFIG_PREEMPT is not set
# CONFIG_PREEMPT_DYNAMIC is not set
# CONFIG_PREEMPT_RCU is not set
# CONFIG_HZ_100 is not set
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_TASK_DELAY_ACCT is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_SCHED_INFO is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_BSD_PROCESS_ACCT is not set
CONFIG_PREEMPT_LAZY=y
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_COUNT=y
CONFIG_HZ_250=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_HZ=250

# Compiler and frequency

CONFIG_CC_IS_CLANG=y
CONFIG_LD_IS_LLD=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN_DIST is not set

# Memory and cgroups

CONFIG_ARM64_16K_PAGES=y
CONFIG_NUMA=y
CONFIG_NUMA_EMU=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_SHMEM_HUGE_NEVER=y
CONFIG_TRANSPARENT_HUGEPAGE_TMPFS_HUGE_NEVER=y
CONFIG_ARM64_CONTPTE=y
CONFIG_HUGETLBFS=y
CONFIG_MIGRATION=y
CONFIG_COMPACTION=y
CONFIG_LRU_GEN=y
CONFIG_SWAP=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_EXPERT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_NODES_SHIFT=4
# CONFIG_NUMA_BALANCING is not set
# CONFIG_THP_SWAP is not set
# CONFIG_SLUB_DEBUG is not set
CONFIG_ZRAM=m

# Profiling, graphics and dumps

CONFIG_PERF_EVENTS=y
CONFIG_ARM_PMU=y
CONFIG_ARM_PMUV3=y
CONFIG_PROFILING=y
CONFIG_TRACEPOINTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KALLSYMS=y
CONFIG_FRAME_POINTER=y
CONFIG_STACKTRACE=y
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_EVENT_TRACING=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_DEV_COREDUMP=y
CONFIG_WANT_DEV_COREDUMP=y
CONFIG_ALLOW_DEV_COREDUMP=y
CONFIG_BRCMDBG=y
CONFIG_DRM_V3D=m
CONFIG_DRM_VC4=m
CONFIG_SND=m
CONFIG_SND_SOC=m
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Core platform and connectivity

CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BRCMSTB=y
CONFIG_MFD_RP1=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_PINCTRL_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_BCM2712_IOMMU=y
CONFIG_BCM2712_MIP=y
CONFIG_MACB=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXT4_FS=y
CONFIG_THERMAL=y
CONFIG_BCM2835_THERMAL=y
CONFIG_FIRMWARE_RP1=m
CONFIG_MBOX_RP1=m
CONFIG_BRCMFMAC=m
CONFIG_OVERLAY_FS=m
CONFIG_NF_TABLES=m
CONFIG_NF_CONNTRACK=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_TUN=m
CONFIG_WIREGUARD=m
CONFIG_SENSORS_PWM_FAN=m

# Removed facilities

# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_VHOST_MENU is not set
# CONFIG_VSOCKETS is not set
# CONFIG_USB_GADGET is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_FUNCTION_PROFILER is not set
# CONFIG_SCHED_TRACER is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_KGDB is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_PM_DEBUG is not set

# Preserved hardening

CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
